#!/usr/bin/env bash
# claude-waybar-panel — right-side rofi overlay showing all active tmux Claude
# sessions with pending-prompt summaries. Lets you pick which one to act on.
#
# Bind waybar's custom/claude on-click to this script.
#
# Actions:
#   Enter    → accept (if pending) or focus terminal (if idle)
#   Alt-a    → accept the pending prompt
#   Alt-r    → reject the pending prompt
#   Alt-g    → focus (Go to) the terminal in a new kitty window
#   Alt-k    → kill the tmux session
#
# Note: Alt-f is deliberately NOT used — rofi binds it by default to
# `kb-move-word-forward` and reusing it triggers a startup error dialog.

set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/claude-waybar/pending"
mkdir -p "$state_dir"

# Gather all claude-* tmux sessions (may be zero).
mapfile -t sessions < <(tmux ls 2>/dev/null | awk -F: '/^claude-/ {print $1}' | sort -u)

if [ ${#sessions[@]} -eq 0 ]; then
  notify-send -a claude-waybar "No active Claude sessions"
  exit 0
fi

# Index pending files by tmux_target.
declare -A pending_file pending_sum pending_age
now=$(date +%s)
shopt -s nullglob
for f in "$state_dir"/*.json; do
  tgt=$(jq -r '.tmux_target // ""' "$f")
  [ -z "$tgt" ] && continue
  pending_file[$tgt]="$f"
  # Prefer the captured summary; fall back to the raw Notification message.
  # Keep more of it — the row wraps across multiple lines and can render
  # up to ~4 wrapped lines of the command.
  sum=$(jq -r '.summary // .message // ""' "$f" | tr '\n' ' ' | head -c 400)
  pending_sum[$tgt]="$sum"
  ts=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  pending_age[$tgt]=$(( now - ts ))
done

# Build rows into an array. Using an array (feed rofi with -sep '\0') lets us
# embed real newlines INSIDE a row's pango markup so each session is a
# two-line card: title on line 1, full command on line 2.
declare -a rows_display rows_meta
# Pango-safe escaping for &, <, > (we're using -markup-rows).
esc() { printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }
# Truncate to N chars with ellipsis.
trim() { local s="$1" n="$2"; if [ "${#s}" -gt "$n" ]; then printf '%s…' "${s:0:$((n-1))}"; else printf '%s' "$s"; fi; }

for s in "${sessions[@]}"; do
  proj=$(esc "${s#claude-}")
  if [ -n "${pending_file[$s]:-}" ]; then
    age="${pending_age[$s]:-0}"
    raw="${pending_sum[$s]:-waiting}"
    # Hard-cap for really pathological cases (multi-line commands, huge one-
    # liners); still generous enough to fit most real actions.
    raw=$(trim "$raw" 320)
    # Word-wrap at ~92 chars so long commands span up to ~4 lines inside
    # the row instead of getting truncated at the panel edge with a "…".
    # Escape pango AFTER folding so wrap columns line up with visible chars.
    wrapped=$(printf '%s' "$raw" | fold -s -w 92)
    wrapped=$(esc "$wrapped")
    row=$(printf '⏸  <b>%s</b>  <span alpha="55%%" size="small">(%ds)</span>\n<span size="small" alpha="80%%">%s</span>' \
      "$proj" "$age" "$wrapped")
    rows_meta+=("$s|1")
  else
    row=$(printf '✓  <b>%s</b>  <span alpha="55%%" size="small">idle</span>' "$proj")
    rows_meta+=("$s|0")
  fi
  rows_display+=("$row")
done

# Self-contained theme, no user-config inheritance (`-no-config`). Literal
# hex values (no @vars) — we hit rendering weirdness when the theme leaned
# on user-defined variables cross-widget.
theme='
window {
    location:         east;
    anchor:           east;
    width:            820px;
    height:           100%;
    padding:          20px;
    border:           0;
    border-radius:    0;
    background-color: #1e2033ee;
    children:         [ mainbox ];
}
mainbox {
    background-color: transparent;
    spacing:          14px;
    padding:          0;
    children:         [ inputbar, message, listview ];
}
inputbar {
    background-color: #2a2d43;
    text-color:       #cdd6f4;
    padding:          12px 14px;
    border:           1px solid;
    border-color:     #89b4fa;
    border-radius:    10px;
    spacing:          8px;
    children:         [ prompt, entry ];
}
prompt {
    background-color: transparent;
    text-color:       #89b4fa;
}
entry {
    background-color: transparent;
    text-color:       #cdd6f4;
    placeholder:      "filter…";
    placeholder-color: #a6adc8;
}
message {
    background-color: #2a2d4380;
    text-color:       #a6adc8;
    padding:          8px 12px;
    border-radius:    8px;
}
textbox {
    background-color: transparent;
    text-color:       inherit;
}
listview {
    background-color: transparent;
    lines:            10;
    fixed-height:     false;
    scrollbar:        false;
    spacing:          8px;
    padding:          0;
}
element {
    background-color: #2a2d43cc;
    text-color:       #cdd6f4;
    padding:          12px 16px;
    border:           1px solid;
    border-color:     #3a3f5c;
    border-radius:    10px;
    spacing:          8px;
    orientation:      horizontal;
    /* Word-wrap long summary lines instead of clipping. */
    cycle:            false;
}
element selected {
    background-color: #3a3f5c;
    text-color:       #89b4fa;
    border-color:     #89b4fa;
}
element-text {
    background-color: transparent;
    text-color:       inherit;
    horizontal-align: 0;
    vertical-align:   0.5;
}
'

mesg="<b>⏎</b> act · <b>alt-a</b> accept · <b>alt-r</b> reject · <b>alt-g</b> go · <b>alt-k</b> kill"

set +e
# Feed rows with NUL separator so embedded \n stays part of a single row
# (pango renders the \n as a line break).
# SOH (\x01) as separator — rofi 2.0's `-sep \0` is broken but SOH works
# reliably. This lets us embed real \n inside each row so pango renders it
# as a line break (with -eh 2 giving each element enough vertical space).
chosen=$(printf '%s\x01' "${rows_display[@]}" | rofi \
  -dmenu -i \
  -sep $'\x01' \
  -no-config \
  -eh 5 \
  -p "Claude" \
  -mesg "$mesg" \
  -markup-rows \
  -theme-str "$theme" \
  -kb-custom-1 "Alt+a" \
  -kb-custom-2 "Alt+r" \
  -kb-custom-3 "Alt+g" \
  -kb-custom-4 "Alt+k")
rc=$?
set -e

if [ "$rc" -eq 1 ] || [ -z "$chosen" ]; then
  exit 0
fi

# Match chosen row → index by literal comparison against the display array.
idx=-1
for i in "${!rows_display[@]}"; do
  if [ "${rows_display[$i]}" = "$chosen" ]; then
    idx=$i
    break
  fi
done

if [ "$idx" -lt 0 ]; then
  notify-send -a claude-waybar "Panel: could not match selection"
  exit 1
fi

meta="${rows_meta[$idx]}"
target="${meta%|*}"
is_pending="${meta#*|}"
proj="${target#claude-}"

action=""
case "$rc" in
  0)
    if [ "$is_pending" = "1" ]; then action="accept"
    else action="focus"
    fi ;;
  10) action="accept" ;;
  11) action="reject" ;;
  12) action="focus"  ;;   # Alt-g
  13) action="kill"   ;;
  *)  exit 0 ;;
esac

if ! tmux has-session -t "$target" 2>/dev/null; then
  notify-send -a claude-waybar -u critical "tmux session missing" "$target"
  [ -n "${pending_file[$target]:-}" ] && rm -f "${pending_file[$target]}"
  pkill -RTMIN+8 waybar 2>/dev/null || true
  exit 1
fi

case "$action" in
  accept)
    tmux send-keys -t "$target" Enter
    notify-send -a claude-waybar "Approved" "$proj"
    [ -n "${pending_file[$target]:-}" ] && rm -f "${pending_file[$target]}"
    ;;
  reject)
    tmux send-keys -t "$target" Escape
    notify-send -a claude-waybar "Rejected" "$proj"
    [ -n "${pending_file[$target]:-}" ] && rm -f "${pending_file[$target]}"
    ;;
  focus)
    setsid -f kitty --title "Claude: $proj" -e tmux attach -t "$target" >/dev/null 2>&1 || \
      setsid -f kitty --title "Claude: $proj" -e tmux attach -t "$target"
    ;;
  kill)
    tmux kill-session -t "$target"
    notify-send -a claude-waybar "Killed" "$target"
    [ -n "${pending_file[$target]:-}" ] && rm -f "${pending_file[$target]}"
    ;;
esac

pkill -RTMIN+8 waybar 2>/dev/null || true
